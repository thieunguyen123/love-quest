# Mẫu biến môi trường — copy thành .env.local (local) rồi điền giá trị. KHÔNG commit file có giá trị thật.
# Trên Vercel: khai báo ở Project → Settings → Environment Variables.

# --- Supabase (bắt buộc) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng server-side (API tấn công /api/attack/*, push, script seed) — KHÔNG để lộ ra client, KHÔNG thêm tiền tố NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- Thông báo đẩy khi đóng app (tuỳ chọn) — tạo bằng: npx web-push generate-vapid-keys ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# dạng mailto:email-cua-ban
VAPID_SUBJECT=
# chuỗi ngẫu nhiên, trùng với game_config.PUSH_WEBHOOK_SECRET
PUSH_WEBHOOK_SECRET=

# --- Chỉ khi chạy script seed lên production (không cần trên Vercel) ---
# 2 email tài khoản thật đã tạo ở Supabase Dashboard; email đầu là Admin. Không đặt = tạo 2 tài khoản dev (chỉ local).
# SEED_COUPLE=email_admin,email_nguoi_choi
