{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3100",
    "build": "next build --turbopack",
    "start": "next start -p 3100",
    "lint": "eslint",
    "test": "vitest run",
    "seed:export": "tsx scripts/export-spec.ts",
    "seed:db": "tsx scripts/seed-db.ts",
    "db:reset": "supabase db reset && tsx scripts/seed-db.ts",
    "test:it": "tsx scripts/it-phase1.ts",
    "test:http": "tsx scripts/http-smoke.ts",
    "test:it3": "tsx scripts/it-phase3.ts",
    "db:test:reset": "cd .sbtest && supabase db reset --workdir . && cd .. && IT_ENV=.env.test tsx scripts/seed-db.ts",
    "test:all": "IT_ENV=.env.test sh -c 'tsx scripts/it-phase1.ts && tsx scripts/it-phase3.ts && tsx scripts/it-phase4.ts && tsx scripts/it-phase5.ts && tsx scripts/it-phase6.ts && tsx scripts/it-phase8.ts && tsx scripts/it-phase13.ts && tsx scripts/it-phase14.ts && tsx scripts/it-phase15.ts'",
    "db:test:start": "cd .sbtest && supabase start --workdir . -x imgproxy,edge-runtime,logflare,vector,supavisor,mailpit",
    "db:test:stop": "cd .sbtest && supabase stop --workdir .",
    "test:smoke": "IT_ENV=.env.test SMOKE_BASE=http://127.0.0.1:3101 tsx scripts/http-smoke.ts",
    "test:e2e": "IT_ENV=.env.test tsx scripts/e2e-world.ts",
    "test:flow": "IT_ENV=.env.test tsx scripts/e2e-flow.ts",
    "models:build": "tsx scripts/build-models.mts",
    "test:e2e9": "IT_ENV=.env.test tsx scripts/e2e-phase9.ts",
    "test:showcase": "IT_ENV=.env.test tsx scripts/e2e-showcase.ts",
    "test:e2e12": "IT_ENV=.env.test tsx scripts/e2e-phase12.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@react-three/drei": "^10.0.4",
    "@react-three/fiber": "^9.0.4",
    "@react-three/rapier": "^2.2.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.109.0",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.72.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.23.0",
    "three": "^0.171.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^4.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.171.0",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "meshoptimizer": "^1.3.0",
    "supabase": "^3.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12",
    "xlsx": "^0.18.5"
  }
}
